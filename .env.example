# Supabase project settings (safe for the browser when using publishable key)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY

# Supply these server-only values through a secret manager; placeholders are not valid keys.
WHATSAPP_CREDENTIALS_ACTIVE_KEY_VERSION=
WHATSAPP_CREDENTIALS_KEYRING=
