# ==============================================================================
# EDVÂNIA — Variáveis de Ambiente (Modelo .env.example)
# Copie este ficheiro para `.env.local` (ou configure nos Segredos da plataforma)
# e preencha apenas as chaves secretas abaixo. NUNCA coloque chaves reais no Git.
# ==============================================================================

# --- 1. SUPABASE (Opcional em pré-visualização; obrigatório em produção) ---
# Encontre estes valores no painel do seu projecto Supabase:
# Project Settings -> API -> Project URL e Publishable / Secret keys.
# Se ficarem vazios localmente, a app entra em modo de demonstração em memória.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- 2. INTELIGÊNCIA ARTIFICIAL / LLM (Apenas servidor; nunca usar NEXT_PUBLIC_) ---
# Modelo principal escolhido: Gemini 2.5 Flash Lite (Google AI Studio)
# Obtenha a chave em: https://aistudio.google.com/apikey
GEMINI_API_KEY=
LLM_PRIMARY_MODEL=gemini-2.5-flash-lite

# Modelo de recurso (fallback) escolhido: ChatGPT 4o-mini (OpenAI)
# Obtenha a chave em: https://platform.openai.com/api-keys
# Se deixar GEMINI_API_KEY e LLM_FALLBACK_API_KEY vazios, a Edvânia usa o modo sandbox local.
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_URL=https://api.openai.com/v1
LLM_FALLBACK_MODEL=gpt-4o-mini

# --- 3. CIFRAGEM E AUTENTICAÇÃO WHATSAPP (Apenas servidor) ---
# Versão activa da chave (ex.: v1)
WHATSAPP_CREDENTIALS_ACTIVE_KEY_VERSION=v1
# JSON com o mapa versão -> chave AES-256 em base64url (43 caracteres / 32 bytes).
# Para gerar uma chave de teste segura no terminal, execute:
# node -e "console.log(JSON.stringify({v1: require('crypto').randomBytes(32).toString('base64url')}))"
WHATSAPP_CREDENTIALS_KEYRING=
# Segredos opcionais para autenticar webhooks e o endpoint de despacho da fila outbox
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_WORKER_SECRET=